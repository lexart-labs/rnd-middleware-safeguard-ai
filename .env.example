# Copy to .env and fill in. NEVER commit your real .env.

# --- Gemini (required) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Models (optional; defaults shown) ---
# Model used to serve chat completions:
GEMINI_MODEL=gemini-3-flash-preview
# Cheaper model used only for building the training dataset:
DATASET_MODEL=gemini-3.1-flash-lite-preview

# --- Retraining (optional; defaults shown) ---
# New feedback records that trigger an automatic background retrain:
RETRAIN_THRESHOLD=50
# Minimum total dataset size before training will run:
MIN_SAMPLES_TO_TRAIN=5
# Delay between Gemini calls during dataset generation (seconds):
REQUEST_DELAY_SECONDS=6.0

# --- Budget (optional; defaults shown) ---
# Token budget assigned to seeded demo users:
DEFAULT_USER_LIMIT=10000
